{
  "name": "deep-api-extension",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "node -e \"if(!/^bun\\//.test(process.env.npm_config_user_agent||'')){console.error('本仓库依赖用 bun 管理：请改用 bun install（lockfile 是 bun.lock）');process.exit(1)}\"",
    "build": "tsc --noEmit && node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bump": "node scripts/bump-version.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@types/node": "^26.5.1",
    "esbuild": "^0.24.2",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "version": "0.2.0"
}
