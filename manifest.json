{
  "manifest_version": 3,
  "name": "deep.api — DeepSeek web as OpenAI API",
  "version": "0.1.28",
  "description": "把 DeepSeek 网页版转成 OpenAI 形态接口供其他网站调用（无伴生进程）",
  "permissions": [
    "cookies",
    "storage",
    "tabs",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://chat.deepseek.com/*",
    "https://fe-static.deepseek.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "deep.api"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "bridge-relay.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "bridge-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
